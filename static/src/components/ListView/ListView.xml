<?xml version="1.0" encoding="utf-8"?>

<templates xml:space="preserve">
    <t t-name="mba_bi_dashboard.ListView">
        <div t-if="this.state.isError" class="w-100 d-flex align-items-center justify-content-center" style="height: 90%;">
            <h5 t-out="this.state.errorMessage"></h5>
        </div>
        <div t-if="!this.state.isError" style="overflow: auto; height: 92%;">
            <div class="table-responsive">
                <div class="card-body col-md-12 o_mba_bi_dashboard_list_view">
                    <t t-if="state.columns and state.columns.length">
                        <div class="o_mba_bi_dashboard_table_container">
                            <table t-attf-id="listPreview-{{props.chartId}}" t-if="state.data" class="table styled-table oe_dashboard_table">
                                <thead>
                                    <tr>
                                        <th t-foreach="this.state.columns" t-as="column" t-key="column.id" t-on-click="(ev) => this.sortTable(ev, column)" style="position: sticky; top: 0; background: var(--o-view-background-color, white); z-index: 2;">
                                            <t t-out="column.name" />
                                            <span t-attf-class="sort-icon fa {{state.columns_order[column['column_name']] == undefined || state.columns_order[column['column_name']] == 'desc' ? 'fa-angle-down' : 'fa-angle-up'}} ml-1">  </span>
                                        </th>
                                        <th class="o_icon" style="position: sticky; top: 0; background: var(--o-view-background-color, white); z-index: 2;"></th>
                                    </tr>
                                </thead>
                                <tbody id="table-body">
                                    <tr t-foreach="state.currentRecords" t-as="record" t-key="record.id">
                                        <td t-foreach="this.state.columns" t-as="column" t-key="column.id">
                                            <t t-if="record[column['column_name']] !== false">
                                                <t t-out="record[column['column_name']]" />
                                            </t>
                                            <t t-else="">
                                                -
                                            </t>
                                        </td>
                                        <td t-on-click="(ev) => this.openRecords(ev, record.currentIds)" class="btn_list_edit o_icon" style="cursor: pointer;">
                                            <i class="fa fa-pencil-square-o"></i>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="pagination-container d-flex flex-wrap align-items-center justify-content-between gap-2 mt-2 pt-2 border-top">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="text-muted small">Mostrar:</span>
                                    <select class="form-select form-select-sm" style="width: auto; padding: 2px 24px 2px 8px;" t-att-value="state.pageSize" t-on-change="(ev) => this.setPageSize(ev)">
                                        <option value="10">10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                        <option value="0">Todos</option>
                                    </select>
                                    <p id="page-info" class="mb-0 text-muted small">
                                        Mostrando <t t-out="state.currentRecords.length ? (state.pageSize === 0 ? 1 : ((state.currentPage - 1) * state.pageSize) + 1) : 0" /> -
                                        <t t-out="state.pageSize === 0 ? state.totalRecords : (((state.currentPage - 1) * state.pageSize) + state.currentRecords.length)" />
                                         de <t t-out="state.totalRecords" /> registros
                                    </p>
                                </div>
                                <div t-if="state.totalPages &gt; 1" class="d-flex align-items-center gap-1">
                                    <p id="pagination-info" class="mb-0 small text-muted me-2">Pág. <t t-out="state.currentPage" /> de <t t-out="state.totalPages" /></p>
                                    <button class="btn btn-sm btn-outline-secondary" t-att-disabled="state.currentPage &lt;= 1" t-on-click="() => this.changePage(-1)">⬅️ Anterior</button>
                                    <input type="number" id="currentPage" class="form-control form-control-sm text-center" style="width: 55px;" min="1" t-att-max="state.totalPages" t-att-value="state.currentPage" t-on-change="(ev) => this.goToPage(ev)" />
                                    <button class="btn btn-sm btn-outline-secondary" t-att-disabled="state.currentPage &gt;= state.totalPages" t-on-click="() => this.changePage(1)">Siguiente ➡️</button>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </div>
    </t>
</templates>
